    "views": [
      {
        "id": "write-path",
        "label": "A secret's way out",
        "focus": [
          "cli",
          "ghsync",
          "vault",
          "sqlite",
          "github",
          "audit"
        ],
        "note": "Values are opened by the vault and sealed to GitHub's public key before they leave. The push is one of several egress channels; each one appends a ledger entry through the store."
      },
      {
        "id": "env-files",
        "label": "Rendering env files",
        "focus": [
          "operator",
          "cli",
          "render",
          "vault",
          "envfiles"
        ],
        "note": "Render merges managed keys into the file in place; keys it does not manage are kept unless pruning is asked for."
      },
      {
        "id": "mirror",
        "label": "The blind mirror",
        "focus": [
          "switchyard",
          "daemon",
          "ghsync",
          "github"
        ],
        "note": "The daemon reads the store directly. The API returns metadata, version hashes and sync state — never a plaintext value."
      }
    ]
  },
